{
  "name": "beyhunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "港台日三地 Beyblade X 補貨/預訂情報聚合站",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "dev:web": "npm --prefix web run dev",
    "seed": "node server/seed.js",
    "fetch": "node --env-file-if-exists=.env server/fetcher.js --once",
    "build": "npm --prefix web run build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
