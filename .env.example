# 複製呢個檔做 .env 再填。唔填就唔會推通知（淨係喺 log 顯示）。

# ── Telegram（推薦：最穩、免費）──
# 1. WhatsApp/Telegram 搵 @BotFather → /newbot → 攞 token
# 2. 同你個新 bot 傾一句偈，再開 https://api.telegram.org/bot<token>/getUpdates 攞你嘅 chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── WhatsApp（非官方，用你自己號碼）──
# WHATSAPP_ENABLED=1 就會啟用；server 首次啟動會喺 log 印 QR，
# 用 WhatsApp App → 已連結的裝置 → 連結裝置 掃一次即可。
# WHATSAPP_TO：推去邊——個人 "852xxxxxxxx@c.us"，群組 "xxxxxxxxxxxxx@g.us"
WHATSAPP_ENABLED=
WHATSAPP_TO=
